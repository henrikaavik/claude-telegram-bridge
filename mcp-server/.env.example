# ============================================
# REQUIRED
# ============================================

# Your Telegram chat ID (get from bot with /start command)
TELEGRAM_CHAT_ID=your_chat_id_here

# Shared secret for HMAC message signing (generate with: openssl rand -hex 32)
# MUST match the same secret in existing-solution/.env
QUEUE_HMAC_SECRET=generate_with_openssl_rand_hex_32

# ============================================
# OPTIONAL - Paths
# ============================================

# Queue directory (shared with Telegram bot)
TELEGRAM_QUEUE_DIR=./queue

# Configuration file path
MCP_CONFIG_FILE=./config/mcp-config.json

# ============================================
# OPTIONAL - Security
# ============================================

# Comma-separated allowed Claude session IDs (leave empty to allow all)
# Example: ALLOWED_SESSION_IDS=session-abc-123,session-xyz-789
ALLOWED_SESSION_IDS=

# Comma-separated allowed working directories (leave empty to allow all)
# Example: ALLOWED_WORKING_DIRS=/Users/you/project1,/Users/you/project2
ALLOWED_WORKING_DIRS=

# Enable secret detection (API keys, passwords, tokens)
ENABLE_SECRET_DETECTION=true

# Maximum pending messages in queue
MAX_QUEUE_SIZE=100

# ============================================
# OPTIONAL - Limits
# ============================================

# Log level (debug, info, warn, error)
MCP_LOG_LEVEL=info

# Maximum daily notifications per session
MAX_DAILY_NOTIFICATIONS=100

# Maximum daily questions per session
MAX_DAILY_QUESTIONS=50

# Maximum timeout in seconds (hard limit: 1800 = 30 minutes)
MAX_TIMEOUT_SECONDS=1800

# ============================================
# OPTIONAL - Emergency
# ============================================

# Emergency kill switch - disables all MCP tools immediately
MCP_TELEGRAM_DISABLED=false
