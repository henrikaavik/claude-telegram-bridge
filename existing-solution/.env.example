# ============================================
# OBRIGATÓRIO / REQUIRED
# ============================================

# Token do bot do Telegram (obtenha com @BotFather)
# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ============================================
# RECOMENDADO / RECOMMENDED
# ============================================

# ID(s) do(s) chat(s) autorizado(s) (seu Chat ID do Telegram)
# Authorized chat ID(s) (your Telegram Chat ID)
# Deixe comentado na primeira execução para descobrir seu Chat ID
# Leave commented on first run to discover your Chat ID
# Pode ser um único ID ou múltiplos IDs separados por vírgula
# Can be a single ID or multiple IDs separated by comma
# Exemplos / Examples:
#   Chat privado / Private chat: AUTHORIZED_CHAT_ID=123456789
#   Chat + Grupo / Chat + Group: AUTHORIZED_CHAT_ID=123456789,-987654321
# AUTHORIZED_CHAT_ID=123456789

# Diretório de trabalho do Claude Code
# Claude Code working directory
WORKING_DIR=C:\seu\projeto

# Caminho para o executável do Claude Code CLI
# Path to Claude Code CLI executable
# Windows: C:\Users\SeuUsuario\AppData\Roaming\npm\claude.cmd
# macOS/Linux: claude
CLAUDE_CODE_PATH=claude

# ============================================
# OPCIONAL - Transcrição de áudio / OPTIONAL - Audio transcription
# ============================================

# API Key do OpenAI (para Whisper - transcrição de áudio)
# OpenAI API Key (for Whisper - audio transcription)
# Obtenha em / Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...sua_key_aqui...

# ============================================
# OPCIONAL - Idioma / Language
# ============================================

# Idioma padrão para novos usuários (en, pt, ou nl)
# Default language for new users (en, pt, or nl)
DEFAULT_LANGUAGE=en

# ============================================
# OPCIONAL - MCP Integration / MCP Integration
# ============================================

# Enable MCP (Model Context Protocol) integration
# Habilitar integração MCP (Model Context Protocol)
# Allows Claude Code to send messages to Telegram via MCP tools
# Permite que Claude Code envie mensagens para Telegram via ferramentas MCP
MCP_ENABLED=true

# Queue directory (shared with MCP server)
# Diretório de fila (compartilhado com servidor MCP)
# Must match TELEGRAM_QUEUE_DIR in mcp-server/.env
# Deve corresponder a TELEGRAM_QUEUE_DIR em mcp-server/.env
MCP_QUEUE_DIR=../mcp-server/queue

# HMAC secret for message signing (MUST match mcp-server/.env)
# Segredo HMAC para assinatura de mensagens (DEVE corresponder a mcp-server/.env)
# Generate with: openssl rand -hex 32
# Gerar com: openssl rand -hex 32
QUEUE_HMAC_SECRET=your_shared_secret_here

# ============================================
# OPTIONAL - Security / Segurança
# ============================================

# Require admin privileges for confirmations in group chats (true/false)
# Requer privilégios de administrador para confirmações em chats de grupo (true/false)
# When true, only group admins can confirm destructive operations
# Quando true, apenas administradores do grupo podem confirmar operações destrutivas
# Default: false (any group member can confirm)
# Padrão: false (qualquer membro do grupo pode confirmar)
GROUP_ADMIN_ONLY_CONFIRMATIONS=false
